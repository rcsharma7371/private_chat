# ========================================================
# Private 2-Person Chat & Call App - Environment Variables
# ========================================================

# MongoDB Atlas Replica Set Connection String
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/talk_db?retryWrites=true&w=majority
 DATABASE_URL="mongodb+srv://app_user:strong_password@cluster0.abcde.mongodb.net/talk_production?retryWrites=true&w=majority"


# Server Port and Environment
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# JWT Session Secret (Random 64+ char hex string for signing device-bound session cookies)
SESSION_SECRET="change-this-to-a-secure-random-64-character-hex-string-in-production-environments"

# Coturn STUN/TURN Secret and Domain
TURN_SECRET="super-secure-coturn-shared-secret-must-match-turnserver-conf"
TURN_REALM="talk.local"
TURN_SERVER_URL="turn:localhost:3478"
STUN_SERVER_URL="stun:localhost:3478"

# TTL Cleanup Policies
# Unclaimed link TTL (State B: link exists with no code set). Set to 0 to disable.
UNCLAIMED_LINK_TTL_HOURS=24
# Auto-deletion cron interval for rooms inactive > 30 days (standard cron pattern)
INACTIVE_ROOM_CRON="0 3 * * *"

# Frontend Environment Variables (apps/web)
VITE_API_URL="http://localhost:4000"
VITE_WS_URL="http://localhost:4000"
